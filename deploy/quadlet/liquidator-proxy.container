[Unit]
Description=Liquidator HTTPS proxy
After=liquidator-web.service
Requires=liquidator-web.service

[Container]
ContainerName=liquidator-proxy
Image=docker.io/library/caddy:2
Pod=liquidator.pod
Volume=/opt/liquidator/deploy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/var/lib/liquidator/caddy:/data:Z

[Service]
TimeoutStartSec=900
Restart=always

[Install]
WantedBy=multi-user.target
