[Unit]
Description=Liquidator worker (collectors, notifier, scheduler)
After=liquidator-db.service
Requires=liquidator-db.service

[Container]
ContainerName=liquidator-worker
Image=localhost/liquidator:latest
Pod=liquidator.pod
Environment=DB_HOST=127.0.0.1
Exec=liquidator worker
Volume=/var/lib/liquidator/backups:/backups:Z
Secret=liquidator_db_password,target=db_password
Secret=liquidator_app_key,target=app_key
Secret=liquidator_backup_key,target=backup_key
HealthCmd=liquidator healthcheck worker
HealthInterval=1m

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
